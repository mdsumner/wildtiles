# Singularity definition -- built by CI, pulled by digest on Pawsey.
# Pins: GDAL >= 3.11, R >= 4.5, and the R deps at fixed refs.
Bootstrap: docker
From: ghcr.io/mdsumner/gdal-r:latest   # or a gdal-r-ci image by digest

%post
    Rscript -e 'install.packages(c("dplyr","arrow","gdalraster","jsonlite","digest"))'
    Rscript -e 'pak::pak(c("hypertidy/sds","hypertidy/starc","mdsumner/aatgrid"))'
    # deliberately NO ~/.gdal/gdalrc in this image; the pipeline sets
    # its GDAL config explicitly (see R/pipeline.R set_gdal_envs)

%environment
    export LC_ALL=C
